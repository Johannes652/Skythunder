{
	"schemaVersion": 1,
	"id": "skythunder",
	"version": "${version}",
	"name": "Skythunder",
	"description": "A fun, small mod for Hypixel Skyblock.",
	"authors": [
		"Johannes652 / Johaannes"
	],
	"contact": {
		"homepage": "https://github.com/Johannes652/Skythunder",
		"sources": "https://github.com/Johannes652/Skythunder"
	},
	"license": "MIT",
	"icon": "assets/skythunder/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			{
				"value": "at.johannes.skythunder.Skythunder",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "at.johannes.skythunder.compat.SkythunderModMenuImpl", "adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"skythunder.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"accessWidener": "skythunder.classtweaker",
	"suggests": {
		"modmenu": "*"
	}
}